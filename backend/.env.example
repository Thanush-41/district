# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB - leave MONGO_URI empty to use the built-in in-memory seed store.
# For local Mongo via the provided docker-compose.yml (mapped to host port
# 27018 to avoid clashing with any other local Mongo container), use:
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=district

# Google Places API key (https://console.cloud.google.com/apis/credentials).
# Required only for automated restaurant discovery. Leave empty to skip it.
GOOGLE_MAPS_API_KEY=
# Set to "false" to skip the extra Place Details call (saves API quota, but
# phone/website won't be populated).
GOOGLE_FETCH_DETAILS=true

# Optional overrides for the discovery sweep.
SEARCH_CITIES=Panaji,Margao,Calangute,Candolim,Baga,Mapusa,Anjuna,Vasco,Porvorim
SEARCH_KEYWORDS=restaurant,cafe,bar,pub,bakery,fine dining,seafood,pizza

# How often (in days) each verification should be re-run for a restaurant
# that has already been checked at least once.
DISTRICT_RECHECK_DAYS=30
META_RECHECK_DAYS=3
SWIGGY_RECHECK_DAYS=7

# Hour (UTC, 0-23) the daily scheduler pipeline runs at.
SCHEDULER_HOUR_UTC=2
